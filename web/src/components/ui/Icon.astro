---
// 固定アイコンセット。SNS の platform や活動アイコンなど、名前をキーに参照する。
// 公式ロゴの厳密な再現ではなく、判別できる簡易グリフを採用している（差し替え可能）。
export type IconName =
  | 'x'
  | 'youtube'
  | 'twitch'
  | 'pixiv'
  | 'booth'
  | 'suzuri'
  | 'other'
  | 'external'
  | 'stream'
  | 'illust'
  | 'code'
  | 'nft'
  | 'chevron-right'
  | 'close';

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 20 } = Astro.props;

const paths: Record<IconName, string> = {
  x: 'M4 4l16 16M20 4L4 20',
  youtube: 'M4 7a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V7zM10 8.5v7l6-3.5-6-3.5z',
  twitch: 'M5 3h14v11l-4 4h-4l-2 2H7v-2H4V6l1-3zM12 8v4M16 8v4',
  pixiv: 'M4 4h16v16H4V4zM8 8v8M8 8h4a3 3 0 0 1 0 6H8',
  booth: 'M6 8h12l-1 12H7L6 8zM9 8V6a3 3 0 0 1 6 0v2',
  suzuri: 'M4 8l4-4h8l4 4M4 8v12h16V8M4 8h16M12 12v4',
  other: 'M9 15l6-6M10 6h6a2 2 0 0 1 2 2v6M14 18H8a2 2 0 0 1-2-2v-6',
  external: 'M7 17L17 7M9 7h8v8',
  stream: 'M12 3a4 4 0 0 1 4 4v4a4 4 0 0 1-8 0V7a4 4 0 0 1 4-4zM6 11a6 6 0 0 0 12 0M12 19v2',
  illust: 'M4 20l4-1 11-11-3-3L5 16l-1 4zM14 6l3 3',
  code: 'M8 6l-5 6 5 6M16 6l5 6-5 6',
  nft: 'M12 3l9 9-9 9-9-9 9-9z',
  'chevron-right': 'M9 6l6 6-6 6',
  close: 'M6 6l12 12M18 6L6 18',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]} />
</svg>
