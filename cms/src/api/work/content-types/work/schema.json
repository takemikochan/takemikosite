{
  "kind": "collectionType",
  "collectionName": "works",
  "info": {
    "singularName": "work",
    "pluralName": "works",
    "displayName": "制作実績",
    "description": "生成AIで作ったLP等、外部URLを見てもらうための制作実績"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "liveUrl": {
      "type": "string",
      "required": true
    },
    "techTags": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    }
  }
}
