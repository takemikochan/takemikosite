---
import Button from '../ui/Button.astro';
import { profile } from '../../data/profile';
---

<section class="hero container">
  <div class="hero__content">
    <p class="hero__eyebrow">{profile.shortName.en}</p>
    <h1 class="hero__title">{profile.tagline}</h1>
    <p class="hero__lead">
      走海神社の巫女「{profile.name}」の公式サイト。お知らせ・プロフィール・制作実績・グッズ情報をまとめています。
    </p>
    <div class="hero__actions">
      <Button href="/profile/">プロフィール</Button>
      <Button href="/goods/" variant="secondary">グッズ・リンク</Button>
    </div>
  </div>
  <div class="hero__kv">
    <img src={profile.keyVisual} alt="" width="800" height="1000" />
  </div>
</section>

<style>
  .hero {
    padding-block: var(--sp-9) var(--sp-8);
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }
  .hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    min-width: 0; /* flex item がテキストの内容幅で無限に広がろうとして親をはみ出すのを防ぐ */
  }
  .hero__eyebrow {
    margin: 0;
    color: var(--color-accent);
    font-size: var(--fs-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .hero__title {
    font-size: var(--fs-4xl);
  }
  .hero__lead {
    max-width: 34em;
    color: var(--color-text-muted);
  }
  .hero__actions {
    display: flex;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .hero__kv {
    max-width: 320px;
  }
  .hero__kv img {
    width: 100%;
    height: auto;
  }

  @media (min-width: 1024px) {
    .hero {
      flex-direction: row;
      align-items: center;
    }
    .hero__content {
      flex: 1;
    }
    .hero__kv {
      flex-shrink: 0;
      margin-left: auto;
    }
  }
</style>
