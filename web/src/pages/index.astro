---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import LatestNews from '../components/home/LatestNews.astro';
import AboutTeaser from '../components/home/AboutTeaser.astro';
import NavHub from '../components/home/NavHub.astro';
import SnsList from '../components/profile/SnsList.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { sortPinnedFirst } from '../lib/news';
import { site } from '../data/site';
import { profile } from '../data/profile';

const allNews = await getCollection('news');
const latestNews = sortPinnedFirst(allNews).slice(0, 3);
const snsLinks = await getCollection('snsLinks');

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: [profile.nameEn, profile.shortName.ja, profile.shortName.en],
  description: profile.tagline,
  image: new URL(profile.avatar, site.url).toString(),
  url: site.url,
  sameAs: snsLinks.map((entry) => entry.data.url),
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description: site.description,
};
// </script> がペイロードに含まれていても script タグを閉じてしまわないようにする
const personLdSafe = JSON.stringify(personLd).replace(/</g, '\\u003c');
const websiteLdSafe = JSON.stringify(websiteLd).replace(/</g, '\\u003c');
---

<BaseLayout title={site.name}>
  <script is:inline type="application/ld+json" set:html={personLdSafe} />
  <script is:inline type="application/ld+json" set:html={websiteLdSafe} />
  <main>
    <Hero />
    <LatestNews entries={latestNews} />
    <AboutTeaser />
    <NavHub />
    {
      snsLinks.length > 0 && (
        <section class="container sns-section" data-reveal>
          <SectionHeading title="SNS" level="h3" />
          <SnsList entries={snsLinks} />
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .sns-section {
    padding-block: var(--sp-8) var(--sp-9);
  }
</style>
