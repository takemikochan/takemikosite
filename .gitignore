# 依存関係
node_modules/

# 環境変数（本番シークレットを絶対に含めない）
.env
.env.*
!.env.example

# Astro（web/）
web/dist/
web/.astro/
# release.sh が生成する一時ファイル
web/dist.tar.gz

# Strapi（cms/）
# TypeScript コンパイル出力
cms/dist/
# admin パネルのビルド出力
cms/build/
cms/.cache/
# ローカル開発時の SQLite 等
cms/.tmp/
# ローカル専用 PostgreSQL クラスタ（プロジェクトスコープの venv 的インスタンス）
cms/.pgdata/
cms/public/uploads/*
# アップロード画像は git 管理外（§6.8 のバックアップで守る）
!cms/public/uploads/.gitkeep
# strapi export の出力
cms/exports/

# Cloudflare Worker（worker/）
# wrangler のローカル状態キャッシュ
worker/.wrangler/
# ローカル開発用シークレット
worker/.dev.vars

# レビュー用に生成した文書（脆弱性の詳細を含むため公開リポジトリにコミットしない）
codex_reviewed.md
gemini_reviewed.md

# OS / エディタ
.DS_Store
Thumbs.db
