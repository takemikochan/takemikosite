# 依存関係
node_modules/

# 環境変数（本番シークレットを絶対に含めない）
.env
.env.*
!.env.example

# Astro（web/）
web/dist/
web/.astro/
web/dist.tar.gz         # release.sh が生成する一時ファイル

# Strapi（cms/）
cms/dist/                # TypeScript コンパイル出力
cms/build/                # admin パネルのビルド出力
cms/.cache/
cms/.tmp/                 # ローカル開発時の SQLite 等
cms/public/uploads/*
!cms/public/uploads/.gitkeep   # アップロード画像は git 管理外（§6.8 のバックアップで守る）
cms/exports/               # strapi export の出力

# Cloudflare Worker（worker/）
worker/.wrangler/          # wrangler のローカル状態キャッシュ
worker/.dev.vars           # ローカル開発用シークレット

# OS / エディタ
.DS_Store
Thumbs.db
