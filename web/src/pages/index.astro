---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import LatestNews from '../components/home/LatestNews.astro';
import AboutTeaser from '../components/home/AboutTeaser.astro';
import NavHub from '../components/home/NavHub.astro';
import SnsList from '../components/profile/SnsList.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { sortPinnedFirst } from '../lib/news';
import { site } from '../data/site';

const allNews = await getCollection('news');
const latestNews = sortPinnedFirst(allNews).slice(0, 3);
const snsLinks = await getCollection('snsLinks');
---

<BaseLayout title={site.name}>
  <main>
    <Hero />
    <LatestNews entries={latestNews} />
    <AboutTeaser />
    <NavHub />
    {
      snsLinks.length > 0 && (
        <section class="container sns-section" data-reveal>
          <SectionHeading title="SNS" level="h3" />
          <SnsList entries={snsLinks} />
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .sns-section {
    padding-block: var(--sp-8) var(--sp-9);
  }
</style>
