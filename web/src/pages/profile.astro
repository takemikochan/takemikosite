---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import ProfileCard from '../components/profile/ProfileCard.astro';
import ProfileTable from '../components/profile/ProfileTable.astro';
import ActivityList from '../components/profile/ActivityList.astro';
import SnsList from '../components/profile/SnsList.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import { profile } from '../data/profile';
import { site } from '../data/site';

const snsLinks = await getCollection('snsLinks');
---

<PageLayout title="プロフィール" description={`${profile.name}（${profile.shortName.ja}）のプロフィール。${profile.tagline}`}>
  <section data-reveal>
    <ProfileCard />
  </section>

  <section class="profile-section" data-reveal>
    <ProfileTable />
  </section>

  <section class="profile-section profile-bio" data-reveal>
    {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <section class="profile-section shrine" data-reveal>
    <SectionHeading title={`${profile.shrine.name}`} subtitle={profile.shrine.reading} />
    <p class="shrine__truename">
      巫女としての真名は「{profile.trueName.name}（{profile.trueName.reading}）」。
    </p>
    <p class="shrine__guardian">
      守り神は狛犬ならぬ<strong>{profile.shrine.guardian.name}</strong>。{profile.shrine.guardian.desc}
    </p>
    <div class="shrine__blessings">
      {profile.shrine.blessings.map((blessing) => (
        <span class="shrine__blessing">
          <span class="diamond-bullet" aria-hidden="true" />
          {blessing}
        </span>
      ))}
    </div>
  </section>

  <section class="profile-section" data-reveal>
    <SectionHeading title="活動内容" />
    <ActivityList />
  </section>

  {
    snsLinks.length > 0 && (
      <section class="profile-section" data-reveal>
        <SectionHeading title="SNS・リンク" />
        <SnsList entries={snsLinks} />
      </section>
    )
  }

  <section class="profile-section contact" data-reveal>
    <SectionHeading title="お問い合わせ" level="h3" />
    <p>お仕事のご依頼などは、以下のメールアドレスまでご連絡ください。</p>
    <Button href={`mailto:${site.contactEmail}`} variant="secondary">
      {site.contactEmail}
    </Button>
  </section>
</PageLayout>

<style>
  .profile-section {
    max-width: var(--container-narrow);
  }
  .profile-bio p {
    max-width: 34em;
    line-height: var(--lh-prose);
  }
  .profile-bio p + p {
    margin-top: var(--sp-4);
  }

  .shrine {
    background: var(--color-surface-muted);
    border-radius: var(--radius-lg);
    padding: var(--sp-6);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  .shrine__truename,
  .shrine__guardian {
    margin: 0;
    color: var(--color-text);
  }
  .shrine__blessings {
    display: flex;
    gap: var(--sp-5);
    margin-top: var(--sp-2);
  }
  .shrine__blessing {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-weight: 700;
    color: var(--color-primary);
  }

  .contact p {
    color: var(--color-text-muted);
  }
</style>
